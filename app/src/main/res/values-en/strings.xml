    <!-- About / Welcome -->
    <string name="about_heading">What is BornoChitra?</string>
    <string name="about_description">BornoChitra is an app where you trace the dots with your finger to learn letters, numbers and drawing.</string>
    <string name="about_feature_letters">Write Bangla vowels and consonants, and English small and capital letters.</string>
    <string name="about_feature_numbers">Write Bangla and English numbers and math signs.</string>
    <string name="about_feature_drawing">Draw simple pictures.</string>
    <string name="about_feature_progress">Fill in the blanks and see your progress.</string>
    <string name="welcome_continue">Continue</string>

